# ---------------------------------------------------------------
# Velluto Interiors — environment configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------

# Public site URL (used for canonical links, Open Graph and sitemap)
SITE_URL=https://www.example.com
VITE_SITE_URL=https://www.example.com

# Public contact details — leave blank until confirmed.
# Blank values are simply not displayed (nothing is invented).
VITE_PUBLIC_PHONE=
VITE_PUBLIC_EMAIL=
VITE_PUBLIC_INSTAGRAM_URL=

# ---- API server ----
PORT=3001
NODE_ENV=development
# Comma-separated origins allowed to call the API (dev: Vite server)
CORS_ORIGINS=http://localhost:5173

# Lead storage driver: "json" (file-based, default) or "postgres" (see docs/CRM_INTEGRATION.md)
LEAD_STORAGE=json
# Directory for JSON lead records and uploaded images (kept out of git)
STORAGE_DIR=./storage
# DATABASE_URL=postgres://user:password@localhost:5432/velluto

# Upload limits
UPLOAD_MAX_FILES=6
UPLOAD_MAX_MB=10

# Optional: POST each new lead as JSON to this webhook (CRM, Zapier, Make, n8n …)
LEAD_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header
LEAD_WEBHOOK_SECRET=

# Optional: enables the authenticated admin/CRM endpoints (GET/PATCH /api/leads).
# Use a long random value, e.g. `openssl rand -hex 32`. Leave blank to disable.
ADMIN_API_TOKEN=

# Production: path to the built front-end (default ./dist) and reverse-proxy trust
STATIC_DIR=./dist
TRUST_PROXY=loopback
